# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.
# Both docker compose and the Spring Boot app (via spring.config.import) read .env.

# ---- PostgreSQL container ----
POSTGRES_DB=northcart
POSTGRES_USER=northcart
POSTGRES_PASSWORD=northcart
# Change to 5433 if you already have PostgreSQL installed locally on 5432
POSTGRES_PORT=5432

# ---- Backend: database ----
DB_URL=jdbc:postgresql://localhost:5432/northcart
DB_USERNAME=northcart
DB_PASSWORD=northcart

# ---- Backend: email (Mailpit locally) ----
MAIL_HOST=localhost
MAIL_PORT=1025

# ---- Backend: web ----
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Backend: security (Phase 4) ----
# Leave commented out locally to use the dev-only defaults.
# For any shared or deployed environment, generate a real key:  openssl rand -base64 32
# JWT_SECRET=
# JWT_EXPIRATION=2h
# Bootstrap admin, created at startup if missing (dev default: admin@northcart.local / Admin12345)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# MAIL_FROM=no-reply@northcart.local

# ---- Backend: payments (Phase 8) ----
# Default is the built-in fake gateway: the full checkout works with no account.
# For Razorpay test mode: dashboard.razorpay.com -> Test Mode -> API Keys
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---- Whole stack in Docker: docker compose --profile app up -d --build (Phase 13) ----
# The containers run the PRODUCTION profile, so there are no dev defaults:
#   JWT_SECRET      REQUIRED (the backend refuses to start without it):  openssl rand -base64 32
#   ADMIN_EMAIL / ADMIN_PASSWORD   set them to get an admin account
# Uncomment and fill in:
# JWT_SECRET=
# ADMIN_EMAIL=admin@northcart.local
# ADMIN_PASSWORD=ChangeMe-123
# APP_PORT=3000
# Sample catalog is loaded by default in this local stack; for a real deployment use:
# FLYWAY_LOCATIONS=classpath:db/migration
